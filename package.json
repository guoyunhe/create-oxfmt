{
  "name": "create-oxfmt",
  "version": "1.4.0",
  "description": "A CLI tool to create oxfmt configuration for your project",
  "keywords": [
    "cli",
    "code-style",
    "config",
    "formatter",
    "oxfmt"
  ],
  "homepage": "https://github.com/guoyunhe/create-oxfmt#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/create-oxfmt/issues"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/create-oxfmt.git"
  },
  "bin": "dist/create-oxfmt.mjs",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/create-oxfmt.ts src/index.ts --dts",
    "self-create": "tsx ./src/create-oxfmt.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1",
    "latest-version": "^9.0.0",
    "package-manager-detector": "^1.8.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^26.2.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  }
}
